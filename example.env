# Server-only settings. Never prefix these secrets with VITE_.
NODE_ENV=development
jwtPrivateKey=replace-with-a-long-random-secret
db=mongodb://127.0.0.1:27017/ytso
# Only used when NODE_ENV=test; unit tests use injected model fixtures.
testdb=mongodb://127.0.0.1:27017/ytso-test
YOUTUBE_API_KEY=replace-with-a-youtube-data-api-key
PORT=3000
# Set to 1 only behind exactly one trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY_HOPS=0
